# Copy to .env (never commit .env). Expo reads EXPO_PUBLIC_* variables.
# Base URL must include the API version prefix (/api/v1).
# Emulator note: Android emulator reaches the host via http://10.0.2.2:8000/api/v1.
# Physical device: use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# Set to 'false' to call the real backend; keep 'true' for offline/mock data.
EXPO_PUBLIC_USE_MOCK=false